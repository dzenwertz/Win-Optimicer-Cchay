<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfContained>true</IncludeNativeLibrariesForSelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>..\cchay-optimicer-cs\Assets\reth.ico</ApplicationIcon>
    <AssemblyName>RETH_Optimicer_Setup_v3.0.0</AssemblyName>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Product>RETH Optimicer Setup</Product>
    <Company>RETH</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\publish\RethOptimicer.exe">
      <LogicalName>Payload.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
