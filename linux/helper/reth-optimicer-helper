#!/usr/bin/env python3
"""Asistente privilegiado de RETH Optimicer. Solo acciones en lista blanca."""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

# clave → (mínimo, máximo) aceptados
SYSCTL_ALLOW = {
    "vm.swappiness": (0, 200),
    "vm.dirty_ratio": (1, 100),
    "vm.dirty_background_ratio": (1, 100),
    "vm.vfs_cache_pressure": (1, 1000),
}
SYSCTL_DROPIN = Path("/etc/sysctl.d/99-reth-optimicer.conf")
GOV_RE = re.compile(r"^[a-z0-9_\-]+$")
UNIT_RE = re.compile(r"^[A-Za-z0-9:_.\\@-]+\.(service|socket|timer)$")
PROTECTED = {"dbus.service", "systemd-logind.service", "NetworkManager.service", "sshd.service"}
DNS = {
    "dhcp": None,
    "cloudflare": ("1.1.1.1", "1.0.0.1"),
    "google": ("8.8.8.8", "8.8.4.4"),
    "quad9": ("9.9.9.9", "149.112.112.112"),
    "adguard": ("94.140.14.14", "94.140.15.15"),
}


def _run(cmd: list[str], timeout: int = 120) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)


def _ok(message: str = "", **extra) -> dict:
    data = {"ok": True, "message": message}
    data.update(extra)
    return data


def _err(message: str) -> dict:
    return {"ok": False, "error": message}


def drop_caches(_: dict) -> dict:
    try:
        os.sync()
    except OSError:
        pass
    Path("/proc/sys/vm/drop_caches").write_text("3\n")
    return _ok("Cachés de página liberadas.")


def cgroup_reclaim(req: dict) -> dict:
    target = str(req.get("target", "512M"))
    reclaimed_paths = []
    candidates = [
        Path("/sys/fs/cgroup/memory.reclaim"),
        *Path("/sys/fs/cgroup/user.slice").glob("user-*.slice/memory.reclaim"),
    ]
    for path in candidates:
        if path.is_file():
            try:
                path.write_text(f"{target}\n")
                reclaimed_paths.append(str(path))
            except OSError:
                continue
    if not reclaimed_paths:
        return _err("cgroup v2 memory.reclaim no disponible.")
    return _ok(f"Memoria inactiva reclamada ({len(reclaimed_paths)} slices).")


def compact_memory(_: dict) -> dict:
    path = Path("/proc/sys/vm/compact_memory")
    if not path.exists():
        return _err("compact_memory no está disponible.")
    path.write_text("1\n")
    return _ok("Memoria compactada.")


def zram_compact(_: dict) -> dict:
    compacted = 0
    for path in Path("/sys/block").glob("zram*/compact"):
        try:
            path.write_text("1\n")
            compacted += 1
        except OSError:
            continue
    if not compacted:
        return _ok("No hay zram que compactar.")
    return _ok(f"zram compactado ({compacted}).")


def fstrim(_: dict) -> dict:
    proc = _run(["fstrim", "-av"], timeout=180)
    if proc.returncode != 0:
        return _err((proc.stderr or proc.stdout or "fstrim falló").strip())
    return _ok((proc.stdout or "TRIM completado.").strip())


def _sysctl_value(req: dict) -> tuple[str, int] | dict:
    key = str(req.get("key", ""))
    if key not in SYSCTL_ALLOW:
        return _err("Clave sysctl no permitida.")
    try:
        value = int(req.get("value"))
    except (TypeError, ValueError):
        return _err("Valor inválido.")
    low, high = SYSCTL_ALLOW[key]
    if not low <= value <= high:
        return _err(f"Valor fuera de rango ({low}–{high}).")
    return key, value


def _dropin_lines(key: str) -> list[str]:
    """Líneas del drop-in de RETH sin la clave indicada."""
    if not SYSCTL_DROPIN.exists():
        return []
    return [ln for ln in SYSCTL_DROPIN.read_text().splitlines() if not ln.startswith(f"{key}=")]


def sysctl_set(req: dict) -> dict:
    parsed = _sysctl_value(req)
    if isinstance(parsed, dict):
        return parsed
    key, value = parsed
    proc = _run(["sysctl", "-w", f"{key}={value}"])
    if proc.returncode != 0:
        return _err((proc.stderr or proc.stdout).strip())
    lines = _dropin_lines(key)
    lines.append(f"{key}={value}")
    SYSCTL_DROPIN.write_text("\n".join(lines) + "\n")
    return _ok(f"{key}={value}")


def sysctl_restore(req: dict) -> dict:
    """Aplica el valor original y quita la clave del drop-in (borra el archivo si queda vacío)."""
    parsed = _sysctl_value(req)
    if isinstance(parsed, dict):
        return parsed
    key, value = parsed
    proc = _run(["sysctl", "-w", f"{key}={value}"])
    if proc.returncode != 0:
        return _err((proc.stderr or proc.stdout).strip())
    lines = [ln for ln in _dropin_lines(key) if ln.strip()]
    if lines:
        SYSCTL_DROPIN.write_text("\n".join(lines) + "\n")
    elif SYSCTL_DROPIN.exists():
        SYSCTL_DROPIN.unlink()
    return _ok(f"{key} restaurado a {value}")


def set_governor(req: dict) -> dict:
    name = str(req.get("governor", ""))
    if not GOV_RE.fullmatch(name):
        return _err("Gobernador no válido.")
    cpus = Path("/sys/devices/system/cpu")
    written = 0
    for gov in cpus.glob("cpu*/cpufreq/scaling_governor"):
        try:
            gov.write_text(name + "\n")
            written += 1
        except OSError:
            continue
    if not written:
        return _err("No se pudo aplicar el gobernador.")
    return _ok(f"Gobernador {name} aplicado a {written} núcleos.")


def journal_vacuum(_: dict) -> dict:
    proc = _run(["journalctl", "--vacuum-time=7d"], timeout=60)
    if proc.returncode != 0:
        return _err((proc.stderr or proc.stdout).strip() or "journalctl falló")
    return _ok((proc.stdout or "Diario compactado.").strip())


def pkg_clean_cache(_: dict) -> dict:
    if Path("/usr/bin/pacman").exists():
        proc = _run(["pacman", "-Sc", "--noconfirm"], timeout=180)
    elif Path("/usr/bin/apt-get").exists():
        proc = _run(["apt-get", "clean"], timeout=180)
    elif Path("/usr/bin/dnf").exists():
        proc = _run(["dnf", "clean", "packages"], timeout=180)
    else:
        return _err("Gestor de paquetes no soportado.")
    if proc.returncode != 0:
        return _err((proc.stderr or proc.stdout).strip())
    return _ok("Caché de paquetes limpiada.")


def pkg_remove_orphans(_: dict) -> dict:
    if Path("/usr/bin/pacman").exists():
        listed = _run(["pacman", "-Qtdq"], timeout=60)
        pkgs = [p for p in listed.stdout.split() if p]
        if not pkgs:
            return _ok("No hay paquetes huérfanos.")
        proc = _run(["pacman", "-Rns", "--noconfirm", *pkgs], timeout=300)
    elif Path("/usr/bin/apt-get").exists():
        proc = _run(["apt-get", "autoremove", "-y"], timeout=300)
    elif Path("/usr/bin/dnf").exists():
        proc = _run(["dnf", "autoremove", "-y"], timeout=300)
    else:
        return _err("Gestor de paquetes no soportado.")
    if proc.returncode != 0:
        return _err((proc.stderr or proc.stdout).strip())
    return _ok("Huérfanos eliminados.")


def set_dns(req: dict) -> dict:
    provider = str(req.get("provider", ""))
    if provider not in DNS:
        return _err("Proveedor DNS no válido.")
    servers = DNS[provider]
    if Path("/usr/bin/resolvectl").exists():
        iface_out = _run(["resolvectl", "status"])
        ifaces = []
        for line in iface_out.stdout.splitlines():
            line = line.strip()
            if line.startswith("Link ") and "(" in line:
                name = line.split("(")[-1].rstrip(")")
                if name and name != "lo":
                    ifaces.append(name)
        if iface_out.returncode != 0 or not ifaces:
            return _err("No se detectaron interfaces DNS disponibles.")
        errors = []
        for iface in ifaces:
            if servers is None:
                result = _run(["resolvectl", "revert", iface])
            else:
                result = _run(["resolvectl", "dns", iface, *servers])
            if result.returncode != 0:
                errors.append(f"{iface}: {result.stderr or result.stdout}")
        if errors:
            return _err("No se completó el cambio DNS: " + "; ".join(errors))
        return _ok(f"DNS {provider} aplicado.")
    return _err("Se requiere resolvectl para cambiar DNS de forma reversible.")


def flush_dns(_: dict) -> dict:
    if Path("/usr/bin/resolvectl").exists():
        proc = _run(["resolvectl", "flush-caches"])
        if proc.returncode != 0:
            return _err((proc.stderr or proc.stdout).strip())
        return _ok("Caché DNS vaciada.")
    return _ok("No hay resolvectl; nada que vaciar.")


def _set_conf_line(path: Path, key: str, line: str) -> None:
    """Sustituye la línea «key=...» conservando el resto del archivo."""
    lines = path.read_text().splitlines() if path.exists() else []
    out, found = [], False
    for ln in lines:
        if ln.strip().startswith(f"{key}="):
            out.append(line)
            found = True
        else:
            out.append(ln)
    if not found:
        out.append(line)
    path.write_text("\n".join(out) + "\n")


def _privacy_toggle(target: str, enable: bool) -> dict:
    verb = "enable" if enable else "disable"
    state = "reactivado" if enable else "desactivado"
    if target == "apport":
        _set_conf_line(Path("/etc/default/apport"), "enabled", f"enabled={1 if enable else 0}")
        _run(["systemctl", verb, "--now", "apport.service"])
        return _ok(f"Apport {state}.")
    if target == "popularity-contest":
        conf = Path("/etc/popularity-contest.conf")
        if conf.exists():
            _set_conf_line(conf, "PARTICIPATE", f'PARTICIPATE="{"yes" if enable else "no"}"')
        _run(["systemctl", verb, "--now", "popularity-contest.timer"])
        return _ok(f"popularity-contest {state}.")
    if target == "whoopsie":
        proc = _run(["systemctl", verb, "--now", "whoopsie.service"])
        if proc.returncode != 0:
            return _err((proc.stderr or proc.stdout).strip() or "systemctl falló")
        return _ok(f"whoopsie {state}.")
    if target == "ubuntu-report":
        proc = _run(["chmod", "+x" if enable else "-x", "/usr/bin/ubuntu-report"])
        if proc.returncode != 0:
            return _err((proc.stderr or proc.stdout).strip() or "chmod falló")
        return _ok(f"ubuntu-report {state}.")
    return _err("Objetivo de privacidad no válido.")


def privacy_disable(req: dict) -> dict:
    return _privacy_toggle(str(req.get("target", "")), enable=False)


def privacy_restore(req: dict) -> dict:
    return _privacy_toggle(str(req.get("target", "")), enable=True)


def systemctl_op(req: dict) -> dict:
    op = str(req.get("operation", ""))
    unit = str(req.get("unit", ""))
    if op not in {"enable", "disable"}:
        return _err("Operación no permitida.")
    if not UNIT_RE.fullmatch(unit):
        return _err("Unidad no válida.")
    if unit in PROTECTED and op == "disable":
        return _err("Unidad protegida.")
    proc = _run(["systemctl", op, "--now", unit], timeout=40)
    if proc.returncode != 0:
        return _err((proc.stderr or proc.stdout).strip() or "systemctl falló")
    return _ok(f"{unit}: {op}")


ACTIONS = {
    "drop_caches": drop_caches,
    "cgroup_reclaim": cgroup_reclaim,
    "compact_memory": compact_memory,
    "zram_compact": zram_compact,
    "fstrim": fstrim,
    "sysctl_set": sysctl_set,
    "sysctl_restore": sysctl_restore,
    "set_governor": set_governor,
    "journal_vacuum": journal_vacuum,
    "pkg_clean_cache": pkg_clean_cache,
    "pkg_remove_orphans": pkg_remove_orphans,
    "set_dns": set_dns,
    "flush_dns": flush_dns,
    "privacy_disable": privacy_disable,
    "privacy_restore": privacy_restore,
    "systemctl": systemctl_op,
}


def main() -> int:
    if os.geteuid() != 0:
        print(json.dumps(_err("El asistente debe ejecutarse como root.")), flush=True)
        return 1
    raw = sys.stdin.read()
    try:
        req = json.loads(raw or "{}")
    except json.JSONDecodeError:
        print(json.dumps(_err("JSON inválido.")), flush=True)
        return 1
    if not isinstance(req, dict):
        print(json.dumps(_err("Se requiere un objeto JSON.")), flush=True)
        return 1
    action = str(req.get("action", ""))
    fn = ACTIONS.get(action)
    if fn is None:
        print(json.dumps(_err("Acción no permitida.")), flush=True)
        return 1
    try:
        result = fn(req)
    except Exception as exc:  # noqa: BLE001
        result = _err(str(exc))
    print(json.dumps(result, ensure_ascii=False), flush=True)
    return 0 if result.get("ok") else 2


if __name__ == "__main__":
    raise SystemExit(main())
