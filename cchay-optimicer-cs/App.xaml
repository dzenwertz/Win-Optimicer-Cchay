<Application x:Class="cchay_optimicer_cs.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:cchay_optimicer_cs"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Theme/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="RethAccentColor">#7ED4F5</Color>
            <Color x:Key="RethInkColor">#07090B</Color>
            <Color x:Key="RethSurfaceColor">#101418</Color>
            <SolidColorBrush x:Key="RethAccentBrush" Color="#7ED4F5" />
            <SolidColorBrush x:Key="RethInkBrush" Color="#07090B" />
            <SolidColorBrush x:Key="RethSurfaceBrush" Color="#101418" />
            <SolidColorBrush x:Key="RethMutedBrush" Color="#9AB3C0" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
